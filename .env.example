VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key (NUNCA expor no frontend - sem prefixo VITE_)
# Obtenha em: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_META_BP=
META_IG_ACCOUNT_ID=
META_PAGE_ID=
META_PAGE_NAME=Bismarchi
META_GRAPH_API_VERSION=v23.0
INSTAGRAM_SYNC_CRON_SECRET=
# Opcional para a migração; por padrão o script lê ../marketing-system/.env
ORQESTRA_ENV_FILE=

# Sync SharePoint → Supabase (painel Eficiência Operacional)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Sync Colaboradores: ORQESTRAI (hr_employees) → financeiro-bp, comparação com RESPONSUM
# Nunca usar as chaves anon aqui — sempre a service_role de cada projeto.
ORQESTRAI_SUPABASE_URL=
ORQESTRAI_SERVICE_ROLE_KEY=
# RESPONSUM_SUPABASE_URL / RESPONSUM_SERVICE_ROLE_KEY também são usados pela Edge Function
# abrir-chamados-evidencia (SIOE) — configurar essas duas também em Supabase > Edge Functions >
# Secrets do projeto SIOE (não só aqui no .env local do script de sync).
RESPONSUM_SUPABASE_URL=
RESPONSUM_SERVICE_ROLE_KEY=

# VIOS_REPORT_PATH=C:/Users/bp01/OneDrive - BPPLAW/.../Processos Completo.xlsx
# VIOS_USER=seu_email@bismarchipires.com.br
# VIOS_PASS=sua_senha
# VIOS_HEADLESS=true   (opcional: rodar browser em segundo plano)

# Evolution API (WhatsApp) — também configurar em Supabase > Edge Functions > Secrets
EVOLUTION_API_URL=https://dados-evolution-api.a8fvaf.easypanel.host/
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Web Push (notificações WhatsApp com app fechado)
# Gere com: npx web-push generate-vapid-keys
# Pública → frontend (.env). Privada → Supabase secrets (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
